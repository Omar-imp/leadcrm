# Copy this file to .env and fill in your own values.
# Never commit the real .env file (it is listed in .gitignore).

# --- Groq (AI features: lead scoring, assistants, WhatsApp chatbot) ---
GROQ_API_KEY=your_groq_api_key

# --- Meta WhatsApp Cloud API (WhatsApp chatbot) ---
META_WHATSAPP_TOKEN=your_meta_whatsapp_access_token
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
META_VERIFY_TOKEN=choose_a_unique_verify_token

# --- Email (SMTP via Gmail) ---
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# --- Google OAuth credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- App ---
SITE_BASE_URL=http://127.0.0.1:8000
